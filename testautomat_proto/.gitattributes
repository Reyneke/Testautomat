# Einheitliche Zeilenenden (Entscheidung E-36, Arbeitspaket U-02).
# Textdateien werden auf LF normalisiert; Windows-Skripte bleiben CRLF, Binärdateien bleiben unberührt.
* text=auto
*.sql text eol=lf
/.gitattributes text eol=lf
*.md text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf
*.storyboard text eol=lf
*.xib text eol=lf
*.xcscheme text eol=lf
*.xcsettings text eol=lf
*.xcworkspacedata text eol=lf
*.entitlements text eol=lf
*.xcconfig text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.vcxproj text eol=crlf
*.sln text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.symbols binary
